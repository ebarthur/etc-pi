# .env.example — copy to .env, fill in real values, never commit .env itself
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=SmartToll
TOLL_GATE_NAME=the N1 Highway Toll Point

# Turso (libSQL embedded replica) — leave both blank to run against a plain
# local SQLite file (dev/test), no network involved. Set both to enable
# background sync with Turso; see plan.md Phase 4.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TURSO_SYNC_INTERVAL_SECONDS=30
TURSO_DRIFT_CHECK_INTERVAL_SECONDS=120

# Repeat-toll cooldown (seconds) — suppresses a second charge for the same vehicle within
# this window. See TOLL_REPEAT_COOLDOWN_SECONDS in core/config.py.
TOLL_REPEAT_COOLDOWN_SECONDS=60

# Off by default — audit-logs every "no RFID, no ANPR match" miss, by far the most common
# outcome of a presence trigger. Only turn on for a short demo/field-test session; see
# LOG_IDENTIFICATION_MISSES in core/config.py for the write-volume/SD-card tradeoff.
LOG_IDENTIFICATION_MISSES=
