# .env.example — copy to .env, fill in real values, never commit .env itself
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=SmartToll
TOLL_GATE_NAME=the N1 Highway Toll Point

# Turso (libSQL embedded replica) — leave both blank to run against a plain
# local SQLite file (dev/test), no network involved. Set both to enable
# background sync with Turso; see plan.md Phase 4.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TURSO_SYNC_INTERVAL_SECONDS=30
